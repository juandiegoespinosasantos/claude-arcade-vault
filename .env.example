# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Team inbox that receives the contact form messages
CONTACT_TO_EMAIL=equipo@example.com

# Verified sender. For testing without a domain use: Arcade Vault <onboarding@resend.dev>
# (the sandbox sender can only deliver to the email of your Resend account)
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>
